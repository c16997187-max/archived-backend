# Copy to .env and adjust. Never commit .env.

# development | production
APP_ENV=development

# Used by docker-compose.yml to create the local database
POSTGRES_USER=archived
POSTGRES_PASSWORD=archived
POSTGRES_DB=archived

# SQLAlchemy URL the API and worker connect to. Use 127.0.0.1, not localhost:
# on Windows localhost resolves to ::1 first and the connection can hang.
DATABASE_URL=postgresql+psycopg://archived:archived@127.0.0.1:5432/archived

# Folder for uploaded form images (gitignored; contains student data)
STORAGE_DIR=storage

# Folder holding OCR model weights, loaded from disk (no downloads at runtime).
# Fill it once with `python -m scripts.download_models` on a machine with internet.
MODELS_DIR=models

# Handwritten fields: ppocr (PP-OCRv6, the default: faster, less memory, and the
# license-safe choice for a commercial deployment) or trocr (TrOCR base-handwritten, kept
# for comparison; see README "OCR models" for the benchmark and the IAM license caveat).
OCR_HANDWRITING_MODEL=ppocr
# PP-OCRv6 size for detection and printed text: tiny, small or medium.
OCR_DET_TIER=small
# Fields whose least sure character scores below this are flagged for review (0 to 1).
OCR_CONFIDENCE_THRESHOLD=0.80
# ONNX Runtime threads for OCR. Leave unset for one per physical core.
# OCR_THREADS=

# Folder holding blank form images and their field_boxes JSON (no student data)
FORM_TEMPLATES_DIR=docs/forms

# Secret for signing login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With APP_ENV=production the API refuses to start unless this is set to a
# value of at least 32 characters (not "change-me"). Changing it logs everyone out.
JWT_SECRET=change-me

# Login token lifetimes. Access tokens are short; the refresh cookie lasts a
# school day, or REMEMBER_ME_DAYS when the user ticks "Remember Me".
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=12
REMEMBER_ME_DAYS=30

# Set to true only once the host PC serves HTTPS: browsers drop Secure cookies
# over plain HTTP, and login would silently stop surviving page reloads.
COOKIE_SECURE=false

# Address phones use to reach this PC; it goes into the capture QR code, e.g.
# http://192.168.1.10:8000. Must be set on the host PC: without it a QR made from a
# browser on that PC points at localhost, which a phone cannot reach.
# PUBLIC_BASE_URL=

# Comma-separated origins allowed to call the API from a browser with cookies.
# Leave unset for the default: http://localhost:5173 (Vite dev server) in
# development, none in production, where the API serves the frontend itself.
# CORS_ORIGINS=http://localhost:5173

# Development only. Admin password set by `python -m scripts.seed`; leave
# empty to have the script generate and print one.
SEED_ADMIN_PASSWORD=

# Database for pytest. Defaults to DATABASE_URL's database name + "_test",
# created on first run. The tests wipe and re-migrate it every run.
# TEST_DATABASE_URL=postgresql+psycopg://archived:archived@127.0.0.1:5432/archived_test
